# Base URL of your Snipe-IT instance (the server appends /api/v1)
SNIPEIT_BASE_URL=
SNIPEIT_TIMEOUT_MS=30000

# Write tools (create/update, checkout/checkin, audit) require exactly "true".
# There are NO delete tools — deletion is irreversible for most entities.
SNIPEIT_ENABLE_WRITES=false

# Audit log (JSON lines). Records the tool, a hash of the target, and — when the
# gateway forwards one — the calling user.
SNIPEIT_AUDIT_LOG=

# ---------------------------------------------------------------------------
# Auth: pick ONE of the two modes below.
# ---------------------------------------------------------------------------

# MODE A — shared token (default; stdio and single-operator use).
# One personal access token for the whole server, so EVERY caller acts as the
# token's owner with that account's permissions, and Snipe-IT's own history
# credits every change to them. Fine for a personal setup; wrong for a shared
# multi-user endpoint.
SNIPEIT_API_TOKEN=

# MODE B — per-user auth (multi-user deployments behind an authenticating gateway).
# Each user enrols their OWN Snipe-IT token, so they act as themselves with their
# own permissions and appear correctly in Snipe-IT's history. Leave
# SNIPEIT_API_TOKEN unset — there is deliberately no fallback to it.
#
#   SNIPEIT_PER_USER_AUTH=true
#   SNIPEIT_TRUST_FORWARDED_USER=true    # trust the gateway's X-MCP-User header
#   SNIPEIT_ENCRYPTION_KEY=              # min 16 chars; encrypts tokens at rest
#   SNIPEIT_STORE_PATH=/data/store.json  # persist this, or everyone re-enrols
#   SNIPEIT_PUBLIC_BASE_URL=             # public origin serving /snipeit/enroll
#
# Only set SNIPEIT_TRUST_FORWARDED_USER=true when a gateway you control sets
# X-MCP-User from a validated token and strips any client-supplied copy.
# Otherwise a caller could name any identity and read that person's data.
